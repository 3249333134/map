{
  "name": "map-simple",
  "version": "1.0.0",
  "private": true,
  "description": "微信云开发地图社交小程序：动态、活动与附近互动",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "check:wxml": "node scripts/check-wxml.js",
    "cloud:prepare": "node scripts/prepare-cloud.js",
    "cloud:init": "node scripts/init-cloud.js",
    "avatar-server": "server/.venv/bin/python server/generate_server.py --port 8765",
    "avatar-setup": "python3 -m venv server/.venv && server/.venv/bin/pip install -r server/requirements.txt",
    "smoke": "node scripts/runtime-smoke.js"
  },
  "dependencies": {
    "tdesign-miniprogram": "1.17.0"
  },
  "devDependencies": {
    "@cloudbase/manager-node": "5.9.4"
  }
}
