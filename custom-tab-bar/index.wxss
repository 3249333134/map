.bottom-bar { position: fixed; z-index: 100; bottom: 0; left: 0; right: 0; box-sizing: border-box; background: #fff; border-top: 1px solid #efefeb; overflow: visible; --td-tab-bar-active-color: #1c1c1a; --td-tab-bar-color: #8a8a82; --td-tab-bar-bg-color: #fff; --td-tab-bar-height: var(--footer-height, 48px); --td-spacer: 0px; }
.navigation-bar { height: var(--footer-height, 48px); }
.navigation-label { font-size: 10px; line-height: 14px; }
.with-home-indicator .navigation-standard { top: 8px; }
.publish-circle { position: relative; top: -4px; flex-shrink: 0; width: 48px; height: 48px; border-radius: 50%; background: #1c1c1a; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 16px rgba(24, 24, 20, .22); }
.publish-circle:active { background: #444; }
