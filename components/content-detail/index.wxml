<view class="detail">
  <view class="title">{{item.title}}</view><view class="meta">{{item.author.nickname || '地图朋友'}} · {{item.place}}</view>
  <view wx:if="{{item.status && item.status !== 'published'}}" class="notice">{{item.statusText}} {{item.moderationError}}<button wx:if="{{item.mine && item.status === 'review_error'}}" data-action="content.reviewRetry" bindtap="action" disabled="{{busy}}">重试审核</button></view>
  <button wx:if="{{item.mine && item.status === 'rejected'}}" bindtap="republish">修改后重新发布（需重新选择图片）</button><view class="body">{{item.text}}</view>
  <view class="pictures"><image wx:for="{{item.images}}" wx:key="*this" src="{{item}}" data-url="{{item}}" mode="aspectFill" bindtap="preview" /></view>
  <view wx:if="{{item.kind === 'activity'}}" class="activity"><view>{{item.timeText}}</view><view>{{item.joinedCount}} / {{item.capacity}} 人报名 · {{item.cancelled ? '已取消' : item.activityClosed ? '暂不可报名' : '可报名'}}</view><button wx:if="{{!item.mine && item.status === 'published'}}" data-action="activity.signup" bindtap="action" disabled="{{busy || (!item.joined && item.activityClosed)}}">{{item.joined ? '取消报名' : '一键报名'}}</button></view>
  <view wx:if="{{item.status === 'published'}}" class="actions"><button data-action="like.set" bindtap="action" disabled="{{busy}}">{{item.liked ? '已赞' : '点赞'}} {{item.likes || 0}}</button><button data-action="favorite.set" bindtap="action" disabled="{{busy}}">{{item.saved ? '已收藏' : '收藏'}}</button><button data-action="report.create" bindtap="action" disabled="{{busy}}">举报</button><button open-type="share">分享</button></view>
  <button wx:if="{{item.mine && item.kind === 'post'}}" class="owner" data-action="content.remove" bindtap="action" disabled="{{busy}}">删除我的动态</button><button wx:if="{{item.mine && item.kind === 'activity' && !item.cancelled}}" class="owner" data-action="activity.cancel" bindtap="action" disabled="{{busy}}">取消活动</button>
  <view wx:if="{{item.status === 'published'}}" class="comments"><view class="subheading">评论 {{item.commentCount || 0}}</view><view wx:for="{{comments}}" wx:key="_id" class="comment"><text class="name">{{item.nickname}}</text><text>{{item.text}}</text></view><view wx:if="{{commentError}}" class="notice">{{commentError}}<button bindtap="loadComments">重试</button></view><button wx:if="{{cursor}}" data-more="{{true}}" bindtap="loadComments" loading="{{commentsLoading}}">更多评论</button><view class="editor"><input value="{{comment}}" bindinput="input" maxlength="500" placeholder="写一句评论" /><button data-action="comment.create" bindtap="action" disabled="{{busy || !comment}}">发送</button></view></view>
</view>
