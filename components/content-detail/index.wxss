.detail { padding: 10px 20px 32px; color: #1c1c1a; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { padding: 2px 8px; border-radius: 8px; background: #f4f4f2; color: #6a6a63; font-size: 10px; line-height: 16px; }
.chip.kind { background: #1c1c1a; color: #fff; }
.chip.mine { background: #f7f1df; color: #6b5523; }
.title { margin-top: 10px; color: #1c1c1a; font-size: 22px; font-weight: 700; line-height: 31px; word-break: break-all; letter-spacing: -0.3px; }
.meta { margin-top: 7px; color: #85857d; font-size: 12px; line-height: 19px; }
.body { margin-top: 18px; color: #35352f; font-size: 16px; line-height: 28px; white-space: pre-wrap; word-break: break-all; }

.pictures { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
.detail-image { width: calc((100% - 16px) / 3); height: 104px; border-radius: 11px; background: #f4f4f2; }

.activity-card { margin-top: 18px; padding: 16px; border-radius: 16px; background: #fafaf8; }
.activity-title { color: #1c1c1a; font-size: 14px; font-weight: 700; line-height: 21px; }
.activity-line { margin-top: 6px; color: #5c5c55; font-size: 12px; line-height: 19px; }
.activity-progress { height: 5px; margin-top: 12px; border-radius: 4px; background: #ececea; overflow: hidden; }
.activity-fill { height: 100%; border-radius: 4px; background: #1c1c1a; }
.activity-card .primary, .activity-card .secondary { width: 100%; margin-top: 14px; height: 44px; border-radius: 12px; font-size: 13px; line-height: 42px; }
.activity-card .primary { background: #1c1c1a; color: #fff; font-weight: 600; }
.activity-card .secondary { border: 1px solid #e8e8e4; background: #fff; color: #1c1c1a; }

.actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
.action-chip { width: auto; min-height: 38px; margin: 0; padding: 0 14px; border: 1px solid #ececea; border-radius: 12px; background: #fff; color: #35352f; font-size: 12px; line-height: 36px; }
.action-chip.on { border-color: #1c1c1a; background: #1c1c1a; color: #fff; }
.action-chip:active { opacity: .8; }

.detail .owner { width: 100%; margin: 14px 0 0; padding: 0 14px; border-radius: 12px; background: #fdf1ee; color: #8a4a3a; font-size: 13px; line-height: 44px; }
.detail .owner:active { opacity: .85; }
.notice { margin-top: 12px; padding: 11px 13px; border-radius: 12px; background: #f7f1df; color: #6b5523; font-size: 12px; line-height: 20px; }
.notice-retry { margin-left: 8px; padding: 0 10px; border-radius: 8px; background: #fff; color: #6b5523; font-size: 11px; line-height: 28px; }

.comments { margin-top: 26px; padding-top: 18px; border-top: 1px solid #f0f0ec; }
.subheading { margin-bottom: 6px; color: #1c1c1a; font-size: 15px; font-weight: 700; line-height: 22px; }
.comment-count { color: #9a9a92; font-size: 11px; font-weight: 400; }
.comment { padding: 11px 0; border-bottom: 1px solid #f4f4f0; }
.name { display: block; color: #85857d; font-size: 11px; line-height: 17px; }
.comment-text { display: block; margin-top: 2px; color: #35352f; font-size: 14px; line-height: 22px; word-break: break-all; }
.more-comments { width: 100%; margin-top: 10px; border-radius: 10px; background: #fafaf8; color: #6a6a63; font-size: 12px; line-height: 38px; }
.comments .more-comments { width: 100%; }
.editor { display: flex; gap: 8px; margin-top: 14px; }
.comment-input { flex: 1; min-width: 0; height: 44px; padding: 0 12px; border: 1px solid #ececea; border-radius: 12px; background: #fafaf8; color: #1c1c1a; font-size: 14px; }
.comment-send { flex: 0 0 auto; width: auto; padding: 0 16px; border-radius: 12px; background: #1c1c1a; color: #fff; font-size: 12px; line-height: 44px; }
.detail-busy .action-chip, .detail-busy .owner, .detail-busy .notice-retry, .detail-busy .primary, .detail-busy .secondary, .comment-send-disabled, .signup-disabled { opacity: .45; }
