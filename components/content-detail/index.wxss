.detail{padding:12px 20px 32px;color:#202020}.title{font-size:22px;font-weight:600;line-height:32px;word-break:break-all}.meta{color:#737373;font-size:12px;line-height:20px;margin-top:8px}.body{font-size:16px;line-height:28px;white-space:pre-wrap;word-break:break-all;margin-top:20px}.pictures{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.pictures image{width:96px;height:96px;border-radius:8px}.activity{padding:16px 0;line-height:26px;font-size:13px}.actions{display:flex;gap:8px;margin-top:20px}.detail button{font-size:12px;line-height:40px;padding:0 12px;margin:0;background:#f3f3f1;color:#202020;border-radius:8px}.detail button::after{border:0}.detail button[disabled]{opacity:.5}.owner{margin-top:12px!important}.notice{background:#f6f6f5;padding:12px;font-size:12px;line-height:20px;margin-top:12px}.comments{margin-top:24px}.subheading{font-size:15px;font-weight:600;margin-bottom:12px}.comment{padding:12px 0;border-bottom:1px solid #ececea;font-size:14px;line-height:24px;word-break:break-all}.name{display:block;font-weight:600;font-size:12px}.editor{display:flex;gap:8px;margin-top:16px}.editor input{flex:1;min-width:0;background:#f3f3f1;border-radius:8px;padding:8px;font-size:14px;height:40px;box-sizing:border-box}

.actions{flex-wrap:wrap}.detail button{min-height:44px;line-height:44px;width:auto}.pictures image{width:calc((100% - 16px)/3)}.editor input{height:44px}
