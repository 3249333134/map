.nav{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:1px solid #ececea;z-index:20}.entry{flex:1;width:0;height:48px;background:transparent;color:#737373;font-size:10px;line-height:16px;padding:4px 0;margin:0;border:0;display:flex;flex-direction:column;align-items:center;justify-content:center}.entry::after{border:0}.active{color:#202020;font-weight:600}.plus{width:48px;height:48px;border-radius:50%;background:#202020;display:flex;align-items:center;justify-content:center;margin-top:-16px}.entry text{display:block}
