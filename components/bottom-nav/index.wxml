<view class="nav" style="padding-bottom: {{inset}}px;"><button wx:for="{{items}}" wx:key="id" class="entry {{selected === item.id ? 'active' : ''}} {{item.id === 'publish' ? 'publish' : ''}}" data-id="{{item.id}}" bindtap="tap" aria-label="{{item.label}}"><view wx:if="{{item.id === 'publish'}}" class="plus"><t-icon name="add" size="26px" color="#fff" /></view><block wx:else><t-icon name="{{item.icon}}" size="20px" /><text>{{item.label}}</text></block></button></view>
