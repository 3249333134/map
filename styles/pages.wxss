.page{padding:20px 18px 120px;min-height:100%;background:#fff}.heading{font-size:25px;font-weight:600;line-height:36px;margin-bottom:20px}.muted{font-size:13px;color:#737373;line-height:22px}.error{padding:16px;background:#f6f6f5;font-size:14px;line-height:24px;margin:12px 0;word-break:break-all}.row{padding:18px 0;border-bottom:1px solid #ececea}.row-title{font-size:18px;font-weight:600;line-height:28px}.row-body{font-size:14px;line-height:24px;white-space:pre-wrap;word-break:break-all;margin-top:6px}.field{margin:18px 0}.label{font-size:13px;display:block;color:#555;margin-bottom:8px}.field input,.field textarea,.picker{background:#f3f3f1;border-radius:10px;padding:12px;font-size:15px;line-height:24px;width:100%;box-sizing:border-box}.field textarea{height:180px}.primary{background:#202020;color:#fff;padding:0 16px;border-radius:10px;line-height:46px;font-size:14px;margin-top:16px}.secondary{background:#f3f3f1;color:#202020;padding:0 14px;border-radius:8px;line-height:42px;font-size:13px;margin-top:10px}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 20px}.tabs button{padding:8px 12px;border-radius:20px;font-size:12px;background:#f3f3f1;color:#555}.tabs .active{background:#202020;color:#fff}.page button[disabled]{opacity:.5}.status{font-size:12px;line-height:22px;color:#555}.section{margin-top:24px}.pictures{display:flex;flex-wrap:wrap;gap:8px}.photo{position:relative;width:92px}.photo image{width:92px;height:92px;border-radius:8px}.photo button{font-size:11px;line-height:28px;background:#f3f3f1;border-radius:6px}.inline{display:flex;gap:10px}.inline .field{flex:1;min-width:0}.badge{display:inline-block;background:#202020;color:#fff;border-radius:12px;padding:0 7px;font-size:11px}.page button:active{opacity:.75}

.field input{height:48px;min-height:48px;line-height:24px}.primary,.secondary{width:100%}.tabs button{width:auto}.row-title{word-break:break-all}.page{padding-bottom:calc(78px + env(safe-area-inset-bottom))}
