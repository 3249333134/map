@import '../../styles/pages.wxss';

.hero { padding: 18px 18px 16px; border-radius: 20px; background: #fff; box-shadow: 0 1px 2px rgba(24, 24, 20, .04); }
.hero-title { color: #1c1c1a; font-size: 24px; font-weight: 700; line-height: 32px; letter-spacing: -0.4px; }
.hero-copy { margin-top: 4px; color: #85857d; font-size: 12px; line-height: 20px; }
.search-bar { display: flex; align-items: center; gap: 8px; margin-top: 14px; padding: 0 6px 0 12px; border-radius: 14px; background: #f4f4f2; }
.search-bar input { flex: 1; min-width: 0; height: 44px; color: #1c1c1a; font-size: 14px; }
.placeholder { color: #9a9a92; }
.search-action { height: 34px; margin: 0; padding: 0 14px; border-radius: 11px; background: #1c1c1a; color: #fff; font-size: 12px; line-height: 34px; }

.error { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.error .retry { flex: 0 0 auto; padding: 0 12px; border-radius: 9px; background: #fff; color: #8a4a3a; font-size: 12px; line-height: 30px; }

.list { margin-top: 12px; }
.activity-card { display: flex; gap: 14px; margin-bottom: 10px; padding: 16px; border-radius: 18px; background: #fff; box-shadow: 0 1px 2px rgba(24, 24, 20, .04); }
.activity-card:active { background: #fafaf8; }
.date-block { flex: 0 0 54px; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 58px; border-radius: 14px; background: #f7f1df; color: #6b5523; }
.date-day { font-size: 22px; font-weight: 700; line-height: 26px; }
.date-month { font-size: 10px; line-height: 14px; opacity: .8; }
.activity-main { flex: 1; min-width: 0; }
.activity-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
.activity-title { flex: 1; min-width: 0; color: #1c1c1a; font-size: 16px; font-weight: 600; line-height: 23px; }
.state { flex: 0 0 auto; padding: 2px 8px; border-radius: 9px; background: #eef2e5; color: #55663f; font-size: 10px; line-height: 16px; }
.state.off { background: #f2f2ef; color: #8a8a82; }
.activity-meta { margin-top: 5px; color: #77776f; font-size: 12px; line-height: 19px; }
.activity-time { margin-top: 3px; color: #4a4a44; font-size: 12px; line-height: 19px; }
.progress { height: 5px; margin-top: 10px; border-radius: 4px; background: #f0f0ec; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 4px; background: #1c1c1a; }
.activity-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; color: #85857d; font-size: 11px; line-height: 17px; }
.category-tag { padding: 1px 8px; border-radius: 8px; background: #f4f4f2; color: #6a6a63; font-size: 10px; line-height: 16px; }

.fab { position: fixed; right: 16px; bottom: calc(70px + env(safe-area-inset-bottom)); z-index: 25; display: flex; align-items: center; gap: 6px; height: 46px; margin: 0; padding: 0 18px 0 12px; border-radius: 23px; background: #1c1c1a; color: #fff; font-size: 13px; font-weight: 600; box-shadow: 0 8px 20px rgba(24, 24, 20, .18); }
.fab:active { opacity: .9; }
