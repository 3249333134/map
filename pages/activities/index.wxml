<view class="page"><view class="heading">一起去附近</view><view class="muted">当前地图中心 10 公里内的活动</view><view class="field"><input value="{{query}}" bindinput="input" bindconfirm="search" confirm-type="search" placeholder="搜索活动" /><button class="secondary" bindtap="search">搜索</button></view><button class="primary" bindtap="publish">发起活动</button><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load">重试</button></view><view wx:for="{{items}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="open" aria-role="button"><view class="row-title">{{item.title}}</view><view class="muted">{{item.place}} · {{item.cancelled ? '已取消' : item.activityClosed ? '暂不可报名' : '可报名'}}</view><view class="row-body">{{item.timeText}}</view><view class="muted">{{item.joinedCount}} / {{item.capacity}} 人报名</view></view><view wx:if="{{!items.length && !loading && !error}}" class="error">附近还没有活动，发起第一个吧。</view><view wx:if="{{loading}}" class="muted section">正在加载…</view><button wx:if="{{cursor && !loading}}" class="secondary" bindtap="loadMore">更多活动</button></view><bottom-nav selected="service" />
