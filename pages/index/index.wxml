<view class="screen {{keyboardHeight ? 'keyboard-open' : ''}}" style="--footer-height: {{layout.footer}}px; --handle-height: {{layout.handle}}px; --search-height: {{layout.search}}px; --panel-gap: {{layout.gap}}px;">
  <map wx:if="{{mapVisible}}" id="main-map" class="map" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" markers="{{markers}}" show-location="{{locationGranted}}" enable-rotate="{{false}}" bindtap="mapTap" bindregionchange="regionChanged" bindmarkertap="markerTap" bindcallouttap="markerTap" binderror="mapFailed" bindupdated="mapUpdated" />
  <button wx:if="{{areaDirty}}" class="search-area" style="top: {{topInset}}px;" bindtap="reload">查看这片区域</button>
  <button wx:if="{{!ownPresence && !areaDirty && !mapError && !keyboardHeight && feedMode === 'people' && viewMode === 'browse'}}" class="map-presence-action" style="top: {{topInset}}px;" bindtap="openPresenceSettings">
    <t-icon name="location" size="16px" />让形象上图
  </button>
  <view wx:if="{{encounter}}" class="encounter-overlay" style="padding-top: {{topInset + 8}}px; --encounter-duration: {{encounter.duration}}ms;" catchtap="encounterTap" catchtouchmove="encounterTap">
    <view class="encounter-card" aria-role="status">
      <text class="encounter-title">握手成功</text>
      <view class="encounter-stage">
        <view wx:for="{{encounter.avatars}}" wx:key="id" class="encounter-person">
          <view class="encounter-sprite {{index === 0 ? 'encounter-left' : 'encounter-right'}}">
            <image class="encounter-image" src="{{item.portrait}}" mode="aspectFit" />
            <image wx:if="{{item.action}}" class="encounter-image encounter-action" src="{{item.action}}" mode="aspectFit" />
          </view>
          <text class="encounter-name">{{item.name}}</text>
        </view>
        <view class="encounter-impact" aria-hidden="true">🙌</view>
      </view>
    </view>
  </view>

  <view wx:if="{{mapError}}" class="map-error" style="top: {{topInset}}px;">
    <text>地图暂时未加载，请检查网络</text>
    <button bindtap="retryMap">重试</button>
  </view>
  <button wx:if="{{!keyboardHeight}}" class="locate {{dragging ? 'following-drag' : ''}}" style="bottom: {{panelBottom + panelHeight + 18}}px;" bindtap="locate" loading="{{locating}}" disabled="{{locating}}" aria-label="回到当前位置"><view wx:if="{{!locating}}" class="crosshair"><view /></view></button>

  <view class="panel {{dragging ? 'dragging' : ''}} {{collapsed ? 'collapsed' : ''}} {{viewMode === 'detail' ? 'detail-mode' : ''}} {{viewMode === 'person' ? 'person-mode' : ''}}" style="height: {{panelHeight}}px; bottom: {{panelBottom}}px;">
    <view class="browse-content">
    <view class="panel-header">
      <view class="drag-zone" bindtouchstart="dragStart" catchtouchmove="dragMove" bindtouchend="dragEnd" bindtouchcancel="dragCancel">
        <view class="handle-area" bindtap="togglePanel" aria-role="button" aria-label="{{collapsed ? '展开内容，也可上拖' : '收起内容，也可下拖'}}"><view class="handle" /></view>
      <view class="panel-caption"><text>{{feedMode === 'people' ? '附近的 Cos' : '附近动态'}}</text><text class="result-count">{{feedMode === 'people' ? cosplayers.length + ' 位在线' : items.length + ' 条内容'}}</text></view>
      </view>
      <view class="search-row">
        <view class="search-box"><t-icon name="search" size="18px" color="#737373" /><input value="{{query}}" focus="{{searchFocused}}" bindinput="search" bindfocus="searchFocus" bindblur="finishSearch" bindconfirm="confirmSearch" bindkeyboardheightchange="keyboardChanged" adjust-position="{{false}}" maxlength="60" placeholder="{{feedMode === 'people' ? '搜昵称、角色或附近喊话' : '搜索附近动态'}}" placeholder-class="placeholder" confirm-type="search" aria-label="搜索附近内容" /><button wx:if="{{query.length}}" class="clear-search" bindtap="clearSearch" aria-label="清空搜索"><t-icon name="close-circle-filled" size="18px" color="#737373" /></button></view>
        <button class="panel-toggle" bindtap="togglePanel" aria-label="{{collapsed ? '展开列表' : '收起列表'}}">{{collapsed ? '列表' : '收起'}}</button>
      </view>
    </view>
    <view wx:if="{{feedMode === 'people'}}" class="browse-tabs"><button class="browse-tab active">附近 Cos</button><button class="browse-tab" bindtap="switchToPosts">附近动态</button><button class="shout-entry" bindtap="openShout">喊话</button></view>
    <view wx:if="{{feedMode === 'posts'}}" class="browse-tabs"><button class="browse-tab" bindtap="switchToPeople">附近 Cos</button><button class="browse-tab active">附近动态</button><button class="shout-entry" bindtap="openShout">喊话</button></view>
    <view wx:if="{{shoutOpen}}" class="shout-composer"><view class="shout-head"><text class="shout-title">留一句话给附近的同好</text><button class="shout-close" bindtap="closeShout" aria-label="关闭">×</button></view><view class="shout-row"><input value="{{shoutText}}" bindinput="shoutInput" maxlength="80" placeholder="今天出的是哪个角色？" confirm-type="send" bindconfirm="publishShout" /><button class="shout-send" bindtap="publishShout" loading="{{shoutBusy}}" disabled="{{shoutBusy}}">发送</button></view><view class="shout-quick"><button data-text="今天出角色了，想认识同好！" catchtap="quickShout">今天出角色了</button><button data-text="想找摄影搭子，一起拍 Cos 吗？" catchtap="quickShout">找摄影搭子</button><button data-text="周边交换，欢迎来打招呼～" catchtap="quickShout">交换周边</button></view></view>
    <view wx:if="{{feedMode === 'posts'}}" class="categories">
      <button wx:for="{{categories}}" wx:key="*this" class="category {{activeCategory === item ? 'active' : ''}}" data-category="{{item}}" bindtap="category">{{item}}</button>
    </view>
    <view wx:if="{{feedMode === 'people'}}" class="own-profile-pinned" bindtap="openOwnSettings" aria-role="button" aria-label="我的资料与地图设置">
      <view class="person-avatar"><avatar-head src="{{ownProfile.avatarUrl || '/static/avatars/' + (ownProfile.avatarKey || 'mika') + '.png'}}" full-body="{{!!ownProfile.avatarFrameUrls.length}}" /></view>
      <view class="person-copy">
        <view class="person-name">{{ownProfile.nickname || '我的资料'}}<text class="friend-chip">你</text></view>
        <view class="person-shout">{{ownPresence ? (ownPresence.shout || '在附近逛逛，欢迎来认识我') : '设置形象、位置和附近喊话'}}</view>
        <view class="person-place">{{ownPresence ? ownPresence.place : '当前未在地图上出现'}}</view>
      </view>
      <t-icon name="chevron-right" size="18px" color="#62625a" />
    </view>
    <scroll-view class="content-scroll" scroll-y="{{!dragging}}" enhanced show-scrollbar="{{false}}" scroll-top="{{scrollTop}}" scroll-into-view="{{scrollIntoView}}" bindscroll="scrolled" bindscrolltolower="loadMore">
      <view wx:if="{{demoMode}}" class="demo-note">演示数据 · 只保存在本机</view>
      <view wx:if="{{dataError}}" class="empty"><text>{{dataError}}</text><button class="reset-filters" bindtap="reload">重试</button></view>
      <view wx:if="{{feedMode === 'people' && cosplayers.length}}" class="items person-items">
        <view wx:for="{{cosplayers}}" wx:key="id" wx:if="{{!item.isMine}}" class="person-row {{selectedId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectPerson" aria-role="button" aria-label="查看{{item.avatar.nickname}}的主页">
          <view class="person-avatar-wrap"><view class="person-avatar"><avatar-head src="{{item.avatarPath || item.avatar.avatarUrl || '/static/avatars/' + item.avatar.avatarKey + '.png'}}" full-body="{{!!item.avatar.avatarFrameUrls.length}}" /></view><view wx:if="{{!item.isMine}}" class="online-dot" /></view>
          <view class="person-copy"><view class="person-name">{{item.avatar.nickname}}<text wx:if="{{item.isMine}}" class="friend-chip">你</text><text wx:if="{{item.friendStatus === 'accepted'}}" class="friend-chip">好友</text></view><view class="person-shout">{{item.shout || '在附近逛逛，欢迎来认识我'}}</view><view class="person-place">{{item.place}}</view></view>
          <t-icon name="chevron-right" size="18px" color="#9a9a96" />
        </view>
      </view>
      <view wx:if="{{feedMode === 'posts' && items.length}}" class="items">
        <view wx:for="{{items}}" wx:key="id" id="point-{{item.id}}" class="item {{selectedId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectItem" aria-role="button" aria-label="查看{{item.title}}">
          <view class="item-top"><text class="item-category">{{item.category}}</text><text class="item-place">{{item.place}}</text></view>
          <view class="item-title">{{item.title}}</view>
          <view class="item-text">{{item.text}}</view>
          <view class="item-foot"><text>{{item.author.nickname || '地图朋友'}}</text><text>{{item.likes || 0}} 赞 · {{item.commentCount || 0}} 评论</text></view>
        </view>
      </view>
      <view wx:if="{{feedMode === 'people' && !cosplayers.length && !loading && !dataError}}" class="empty"><view>附近还没有正在地图上的同好</view><text>开启地图出现，或留一句喊话，让同城 Coser 找到你。</text><button class="reset-filters" bindtap="openPresenceSettings">开启地图出现</button></view>
      <view wx:if="{{feedMode === 'posts' && !items.length && !loading && !dataError}}" class="empty"><view>这里还没有动态</view><text>换个关键词、地图区域，或发布第一条动态。</text><button class="reset-filters" bindtap="resetFilters">清除筛选</button></view>
      <view wx:if="{{loading}}" class="demo-note">正在加载…</view><button wx:if="{{feedMode === 'posts' && cursor && !loading}}" class="reset-filters" bindtap="loadMore">加载更多</button>
    </scroll-view>
    </view>
    <view wx:if="{{viewMode === 'detail' && selectedItem}}" class="detail-content">
      <view class="detail-toolbar"><button class="back-to-browse" bindtap="returnToBrowse"><t-icon name="chevron-left" size="18px" /><text>返回浏览</text></button></view>
      <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="detail-{{selectedId}}">
        <view class="detail-body" id="detail-{{selectedId}}">
          <content-detail item="{{selectedItem}}" bindchanged="detailChanged" bindremoved="detailRemoved" />
        </view>
      </scroll-view>
    </view>
    <view wx:if="{{viewMode === 'person' && selectedPerson}}" class="person-detail">
      <view class="detail-toolbar"><button class="back-to-browse" bindtap="returnToBrowse"><t-icon name="chevron-left" size="18px" /><text>返回地图</text></button></view>
      <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="profile-card">
        <view class="profile-avatar"><avatar-head src="{{selectedPerson.avatarPath || selectedPerson.avatar.avatarUrl || '/static/avatars/' + selectedPerson.avatar.avatarKey + '.png'}}" full-body="{{!!selectedPerson.avatar.avatarFrameUrls.length}}" /></view>
        <view class="profile-heading"><text class="profile-name">{{selectedPerson.avatar.nickname}}<text wx:if="{{selectedPerson.isMine}}" class="self-mark">· 你</text></text><text class="profile-location">{{selectedPerson.place}} · {{selectedPerson.movementMode === 'fuzzy' ? '约500米模糊跟随' : selectedPerson.movementMode === 'virtual' ? '虚拟漫游' : selectedPerson.mode === 'current' ? '临时位置' : '选定地点'}}</text></view>
        <view class="profile-tags"><text wx:for="{{selectedPerson.avatar.tags}}" wx:key="*this" class="profile-tag">{{item}}</text><text wx:if="{{!selectedPerson.avatar.tags.length}}" class="profile-tag">Cos 同好</text></view>
        <view class="profile-shout"><text class="profile-shout-label">附近喊话</text><text>{{selectedPerson.shout || '在附近逛逛，欢迎来认识我。'}}</text></view>
        <button wx:if="{{selectedPerson.isMine}}" class="friend-button" bindtap="stopPresence" loading="{{presenceBusy}}" disabled="{{presenceBusy}}">停止地图出现</button>
        <button wx:else class="friend-button {{selectedPerson.friendStatus === 'accepted' ? 'friend-added' : ''}}" bindtap="friendAction" disabled="{{friendBusy || selectedPerson.friendStatus === 'accepted' || selectedPerson.friendStatus === 'pending' || selectedPerson.friendStatus === 'declined'}}" loading="{{friendBusy}}">{{selectedPerson.friendStatus === 'accepted' ? '已是好友' : selectedPerson.friendStatus === 'pending' ? '已发送申请' : selectedPerson.friendStatus === 'declined' ? '对方暂未接受' : '＋  添加好友'}}</button>
        <view class="profile-expiry">地图出现将在 {{presenceExpiryText}} 后自动结束</view>
      </view></scroll-view>
    </view>
  </view>
</view>
