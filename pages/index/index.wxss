.screen { width: 100%; height: 100%; overflow: hidden; }
.search-area{position:absolute;left:16px;z-index:3;background:#fff;border-radius:10px;padding:10px 14px;font-size:13px;box-shadow:0 3px 12px rgba(0,0,0,.1)}
.movement-hint { position: absolute; left: 50%; z-index: 3; transform: translateX(-50%); padding: 7px 12px; border-radius: 16px; background: rgba(255,255,255,.9); color: #55544e; font-size: 11px; line-height: 16px; box-shadow: 0 2px 10px rgba(0,0,0,.08); white-space: nowrap; pointer-events: none; }
.map { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
.handshake-toast { position: absolute; z-index: 4; top: 28%; left: 50%; transform: translateX(-50%); padding: 11px 16px; border-radius: 22px; background: rgba(32,32,30,.88); color: #fff; font-size: 13px; line-height: 20px; box-shadow: 0 5px 18px rgba(0,0,0,.18); animation: handshake-pop .28s ease-out; white-space: nowrap; }
@keyframes handshake-pop { from { opacity: 0; transform: translate(-50%, 8px) scale(.92); } to { opacity: 1; transform: translate(-50%, 0) scale(1); } }
.locate { position: absolute; z-index: 3; right: 16px; width: 44px !important; min-width: 44px; max-width: 44px; margin: 0; padding: 0; height: 44px; background: #fff; border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 16px rgba(0,0,0,.12); transition: bottom 240ms ease-out; }.locate.following-drag { transition: none; }
.locate[disabled] { background: #f6f6f5; }
.crosshair { position: relative; width: 20px; height: 20px; border: 1.5px solid #202020; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.crosshair::before, .crosshair::after { content: ''; position: absolute; background: #202020; }
.crosshair::before { width: 1.5px; height: 26px; }
.crosshair::after { height: 1.5px; width: 26px; }
.crosshair view { position: relative; z-index: 1; width: 14px; height: 14px; background: #fff; border-radius: 50%; }
.crosshair view::after { content: ''; position: absolute; top: 5px; left: 5px; width: 4px; height: 4px; background: #202020; border-radius: 50%; }
.panel { position: absolute; z-index: 2; left: 0; right: 0; background: #fff; border-radius: 24px 24px 0 0; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 -6px 28px rgba(24, 24, 20, .10); transition: height 240ms cubic-bezier(.16,1,.3,1); }
.panel.dragging { transition: none; }
.browse-content, .detail-content { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.detail-mode .browse-content { display: none; }
.person-mode .browse-content { display: none; }
.person-detail { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.detail-toolbar { flex-shrink: 0; padding: 8px 12px 0; }
.back-to-browse { display: inline-flex; gap: 4px; align-items: center; height: 44px; padding: 0 8px; color: #202020; font-size: 14px; background: transparent; border-radius: 8px; }
.back-to-browse:active { background: #f3f3f1; }
.detail-scroll { flex: 1; min-height: 0; height: 0; }
.detail-body { padding: 12px 20px 28px; }
.detail-title { font-size: 22px; font-weight: 600; line-height: 32px; overflow-wrap: break-word; }
.detail-meta { margin-top: 8px; font-size: 12px; color: #737373; line-height: 20px; }
.detail-text { margin-top: 20px; font-size: 16px; line-height: 28px; white-space: pre-wrap; overflow-wrap: break-word; }
.panel-header { flex-shrink: 0; }
.drag-zone { padding: 0 16px; }
.handle-area { height: var(--handle-height, 28px); display: flex; align-items: center; justify-content: center; }
.handle { width: 36px; height: 4px; background: #c5c5c2; border-radius: 3px; }
.collapsed .panel-header { padding-bottom: var(--panel-gap, 12px); }
.collapsed .panel-caption, .collapsed .categories { display: none; }
.panel-caption { display: flex; justify-content: space-between; align-items: center; font-size: 17px; line-height: 25px; font-weight: 600; }
.result-count { font-size: 12px; color: #737373; font-weight: 400; }
.search-row { display: flex; gap: 10px; padding: 0 16px; flex-shrink: 0; }
.search-box { display: flex; align-items: center; gap: 10px; background: #f3f3f1; padding: 0 12px; border-radius: 12px; height: var(--search-height, 44px); flex: 1; min-width: 0; }
.search-box input { flex: 1; min-width: 0; font-size: 14px; }
.placeholder { color: #737373; }
.clear-search { flex: 0 0 32px; width: 32px !important; height: 40px; display: flex; align-items: center; justify-content: center; background: transparent; padding: 0; margin: 0 -8px 0 0; }
.panel-toggle { flex: 0 0 52px; width: 52px !important; min-width: 52px; max-width: 52px; margin: 0; padding: 0; height: var(--search-height, 44px); background: #f3f3f1; color: #202020; font-size: 13px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
.categories { display: flex; gap: 8px; padding: 10px 16px 8px; flex-shrink: 0; }
.browse-tabs { display: flex; align-items: center; gap: 8px; padding: 12px 16px 4px; flex-shrink: 0; }
.browse-tab { height: 34px; margin: 0; padding: 0 15px; border-radius: 18px; background: #f4f4f2; color: #77776f; font-size: 12px; line-height: 34px; }
.browse-tab.active { color: #fff; background: #1c1c1a; font-weight: 600; }
.shout-entry { margin: 0 0 0 auto; height: 34px; padding: 0 15px; border-radius: 18px; background: #f7f1df; color: #6b5523; font-size: 12px; line-height: 34px; font-weight: 600; }
.shout-composer { display: flex; flex-direction: column; gap: 9px; margin: 8px 16px 4px; padding: 12px; border-radius: 16px; background: #fffaf0; flex-shrink: 0; }
.shout-head { display: flex; align-items: center; justify-content: space-between; }
.shout-title { color: #6b5523; font-size: 12px; font-weight: 600; line-height: 18px; }
.shout-row { display: flex; align-items: center; gap: 8px; }
.shout-composer input { flex: 1; min-width: 0; height: 40px; padding: 0 12px; border-radius: 12px; background: #fff; font-size: 13px; }
.shout-send { flex: 0 0 auto; height: 38px; margin: 0; padding: 0 15px; border-radius: 11px; background: #1c1c1a; color: #fff; font-size: 12px; line-height: 38px; }
.shout-composer .shout-close { flex: 0 0 24px; width: 24px; height: 24px; padding: 0; margin: 0; border-radius: 50%; background: #f0e7d2; color: #8a7442; font-size: 16px; line-height: 24px; }
.shout-quick { display: flex; flex-wrap: wrap; gap: 6px; }
.shout-quick button { height: 28px; line-height: 28px; padding: 0 10px; border-radius: 14px; background: #fff; color: #7c6737; font-size: 10px; }
.shout-quick button:active { background: #fdf3dd; }
.collapsed .browse-tabs, .collapsed .shout-composer { display: none; }
.category { padding: 8px 16px; border-radius: 20px; background: #f6f6f5; color: #666; font-size: 13px; }
.category.active { background: #202020; color: #fff; }
.category:active, .panel-toggle:active, .locate:active { opacity: .7; }
.content-scroll { flex: 1; height: 0; min-height: 0; }
.demo-note { display: inline-block; margin: 0 20px 8px; padding: 3px 9px; border-radius: 9px; background: #f4f4f2; font-size: 10px; color: #85857d; line-height: 16px; }
.items { padding: 0 16px; }
.item { margin-bottom: 8px; padding: 14px 16px; border-radius: 16px; background: #fafaf8; }
.item:active { background: #f4f4f2; }
.item-top { display: flex; justify-content: space-between; align-items: center; font-size: 11px; }
.item-category { padding: 2px 8px; border-radius: 8px; background: #fff; color: #5c5c55; font-size: 10px; line-height: 16px; }
.item-place { color: #8a8a82; }
.item-title { margin-top: 9px; color: #1c1c1a; font-size: 18px; font-weight: 600; line-height: 27px; }
.item-text { margin-top: 4px; color: #5c5c55; font-size: 13px; line-height: 21px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.item-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; color: #9a9a92; font-size: 10px; line-height: 16px; }
.person-items { padding-bottom: 20px; }
.person-row { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; padding: 13px 14px; border-radius: 16px; background: #fafaf8; }
.person-row:active { background: #f4f4f2; }
.person-avatar-wrap { position: relative; flex: 0 0 48px; }
.person-avatar { width: 48px; height: 48px; border-radius: 50%; background: #f4f4f2; }
.online-dot { position: absolute; right: 1px; bottom: 1px; width: 11px; height: 11px; border: 2px solid #fafaf8; border-radius: 50%; background: #7f9a5c; }
.person-copy { min-width: 0; flex: 1; }
.person-name { color: #1c1c1a; font-size: 14px; line-height: 20px; font-weight: 600; }
.person-shout { margin-top: 3px; overflow: hidden; color: #5c5c55; font-size: 12px; line-height: 18px; white-space: nowrap; text-overflow: ellipsis; }
.person-place { margin-top: 3px; color: #8a8a82; font-size: 11px; line-height: 16px; }
.friend-chip { margin-left: 7px; padding: 2px 6px; border-radius: 8px; color: #596746; background: #eef2e5; font-size: 10px; font-weight: 400; }
.self-mark { margin-left: 6px; color: #737373; font-size: 12px; font-weight: 400; }
.profile-card { padding: 14px 22px 28px; }
.profile-avatar { display: block; width: 76px; height: 76px; border-radius: 50%; background: #f6f6f5; }
.profile-heading { display: flex; flex-direction: column; gap: 4px; margin-top: 12px; }
.profile-name { color: #202020; font-size: 22px; line-height: 30px; font-weight: 650; }
.profile-location { color: #737373; font-size: 12px; line-height: 18px; }
.profile-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }
.profile-tag { padding: 5px 10px; border-radius: 13px; background: #f3f3f1; color: #555; font-size: 11px; }
.profile-shout { display: flex; flex-direction: column; gap: 7px; margin-top: 17px; padding: 13px 0; border-top: 1px solid #ececea; border-bottom: 1px solid #ececea; color: #353535; font-size: 14px; line-height: 22px; white-space: pre-wrap; overflow-wrap: break-word; }
.profile-shout-label { color: #888; font-size: 11px; line-height: 16px; }
.person-detail .friend-button { width: 100%; margin-top: 16px; height: 46px; line-height: 46px; border-radius: 13px; background: #202020; color: #fff; font-size: 14px; }
.person-detail .friend-button.friend-added { color: #555; background: #f3f3f1; }
.profile-expiry { margin-top: 10px; text-align: center; color: #888; font-size: 11px; line-height: 16px; }
.selected .item-title { text-decoration: underline; text-underline-offset: 4px; }
.empty { margin: 16px 20px; padding: 30px 18px; border-radius: 18px; background: #fafaf8; text-align: center; color: #1c1c1a; font-size: 15px; font-weight: 600; line-height: 24px; }
.empty text { display: block; margin-top: 6px; color: #8a8a82; font-size: 12px; font-weight: 400; line-height: 20px; }
.reset-filters { display: inline-block; margin-top: 16px; padding: 0 18px; border-radius: 11px; background: #1c1c1a; color: #fff; font-size: 12px; line-height: 38px; }
.map-error { position: absolute; z-index: 5; left: 16px; right: 16px; background: #fff; padding: 12px; border-radius: 12px; font-size: 12px; display: flex; align-items: center; justify-content: space-between; }
.map-error button { background: #202020; color: #fff; padding: 8px 14px; border-radius: 8px; }
.bottom-bar { position: absolute; z-index: 4; bottom: 0; left: 0; right: 0; background: #fff; border-top: 1px solid #efefeb; overflow: visible; --td-tab-bar-active-color: #1c1c1a; --td-tab-bar-color: #8a8a82; --td-tab-bar-bg-color: #fff; --td-tab-bar-height: var(--footer-height, 48px); --td-spacer: 0px; }
.keyboard-open .bottom-bar { display: none; }
.navigation-bar { height: var(--footer-height, 48px); }
.navigation-label { font-size: 10px; line-height: 14px; }
/* 将普通入口略向下居中，缩短文字到手势条的视觉距离，仍保留完整安全区。 */
.with-home-indicator .navigation-standard { top: 8px; }
.publish-circle { position: relative; top: -4px; flex-shrink: 0; width: 48px; height: 48px; border-radius: 50%; background: #1c1c1a; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 16px rgba(24, 24, 20, .22); }
.publish-circle:active { background: #444; }
@media (prefers-reduced-motion: reduce) { .panel, .locate { transition: none; } }
