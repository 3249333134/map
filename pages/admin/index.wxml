<view class="page"><view class="heading">内容与举报管理</view><view class="muted">仅云端配置的管理员可用。图片未完成审核或平台拒绝的内容不可直接批准。</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load">重试</button></view><view wx:for="{{items}}" wx:key="id" class="row"><view class="row-title">{{item.title}}</view><view class="status">{{item.statusText}} {{item.moderationError}}</view><button class="secondary" bindtap="open" data-id="{{item.id}}">查看内容与图片</button><view class="tabs"><button data-id="{{item.id}}" data-decision="approve" bindtap="resolve" disabled="{{busy}}">人工批准</button><button data-id="{{item.id}}" data-decision="reject" bindtap="resolve" disabled="{{busy}}">拒绝公开</button></view></view><view class="heading section">待处理举报</view><view wx:for="{{reports}}" wx:key="_id" class="row"><view class="row-body">{{item.reason}}</view><button class="secondary" bindtap="open" data-id="{{item.targetId}}">查看被举报内容</button><view class="tabs"><button data-id="{{item.targetId}}" data-report="{{item._id}}" data-decision="hide" bindtap="resolve" disabled="{{busy}}">下架并结案</button><button data-id="{{item.targetId}}" data-report="{{item._id}}" data-decision="dismiss" bindtap="resolve" disabled="{{busy}}">无需下架，结案</button></view></view><view wx:if="{{loaded && !items.length && !reports.length}}" class="muted">没有待处理记录</view><button wx:if="{{cursor || reportCursor}}" class="secondary" bindtap="more" disabled="{{busy}}">加载更多</button></view>
