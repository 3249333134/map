@import '../me/index.wxss';
.avatar-library-scroll { width: 100%; white-space: nowrap; }
.avatar-library-row { display: flex; padding: 4px 0; }
.page .avatar-choice { display: flex; flex: 0 0 16.6667%; flex-direction: column; align-items: center; gap: 5px; min-width: 48px; margin: 0; padding: 5px 2px; background: transparent; border-radius: 10px; }
.avatar-choice-portrait { position: relative; width: 38px; height: 38px; overflow: hidden; border: 1px solid #e7e7e2; border-radius: 50%; background: #ece8fa; }
.avatar-choice:nth-child(6n + 1) .avatar-choice-portrait { background: #f6d574; }
.avatar-choice:nth-child(6n + 2) .avatar-choice-portrait { background: #83c7d9; }
.avatar-choice:nth-child(6n + 3) .avatar-choice-portrait { background: #e9a6bf; }
.avatar-choice:nth-child(6n + 4) .avatar-choice-portrait { background: #b6a1dd; }
.avatar-choice:nth-child(6n + 5) .avatar-choice-portrait { background: #a8c4ec; }
.avatar-choice:nth-child(6n + 6) .avatar-choice-portrait { background: #f3ae8c; }
.avatar-choice-name { display: block; width: 100%; overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; color: #62625a; font-size: 11px; line-height: 17px; }
.avatar-choice-selected .avatar-choice-portrait { border-color: #202020; }
.avatar-choice-selected .avatar-choice-name { color: #202020; font-weight: 600; }
.avatar-library-hint { margin-top: 4px; color: #62625a; font-size: 11px; line-height: 18px; }
.speed-setting { margin-top: 16px; padding: 12px; border-radius: 12px; background: #f4f4f2; }
.speed-heading, .speed-range { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.speed-heading { color: #202020; font-size: 13px; line-height: 20px; }
.speed-range { margin-bottom: 6px; color: #62625a; font-size: 12px; line-height: 18px; }
