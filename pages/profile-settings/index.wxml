<view class="page">
  <view wx:if="{{!cloudConfigured && !demoMode}}" class="error">云环境尚未配置，暂时无法同步资料或在地图上出现。</view>
  <view wx:if="{{loading}}" class="muted">正在加载资料…</view>
  <view id="profile-details" class="card section">
    <view class="card-title">资料与形象</view>
    <view class="field"><text class="label">昵称</text><input value="{{nickname}}" bindinput="input" maxlength="20" placeholder="填写昵称" /></view>
    <view class="field"><text class="label">角色与兴趣（最多 5 个）</text><input value="{{tagsText}}" bindinput="tagsInput" maxlength="60" placeholder="原神、约拍、逛展" /></view>
    <view class="field">
      <text class="label">选择一个形象</text>
      <scroll-view class="avatar-library-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="avatar-library-row">
          <button wx:for="{{avatarLibrary}}" wx:key="id" class="avatar-choice {{activeAvatarId === item.id ? 'avatar-choice-selected' : ''}}" bindtap="chooseLibraryAvatar" bindlongpress="avatarOptions" data-id="{{item.id}}" disabled="{{switchingAvatar || saving}}" aria-label="{{item.name}}{{activeAvatarId === item.id ? '，当前使用' : ''}}，长按管理">
            <view class="avatar-choice-portrait"><avatar-head src="{{item.frames[0]}}" /></view>
            <text class="avatar-choice-name">{{item.name}}</text>
          </button>
        </view>
      </scroll-view>
      <view wx:if="{{avatarLibrary.length}}" class="avatar-library-hint">点击切换 · 长按预览或重命名</view>
      <view wx:if="{{!loading && !avatarLibrary.length}}" class="muted">还没有形象，生成后会自动加入这里。</view>
    </view>
    <view class="avatar-actions">
      <button class="secondary" bindtap="aiAvatar" disabled="{{saving || switchingAvatar}}">＋ 生成新形象</button>
    </view>
    <view wx:if="{{profile.avatarReviewStatus === 'pending'}}" class="status section">头像审核中，审核通过后会显示在公开地图上</view>
    <view wx:if="{{profile.avatarReviewStatus === 'review' || profile.avatarReviewStatus === 'rejected' || profile.avatarReviewStatus === 'review_error'}}" class="status section">这张形象暂不能公开，请更换参考图后重新生成</view>
    <button class="primary" bindtap="save" disabled="{{saving || !nickname || (!cloudConfigured && !demoMode)}}" loading="{{saving}}">保存资料</button>
  </view>

  <view id="map-presence" class="card section">
    <view class="presence-heading">出现在附近地图</view>
    <view class="muted">{{demoMode ? '演示模式 · 形象和位置仅在本机显示' : '开启后，附近同好可看到你选定的位置和形象。'}}</view>
    <view class="movement-modes"><button class="mode-button {{movementMode === 'stationary' ? 'mode-active' : ''}}" data-mode="stationary" bindtap="selectMovementMode">固定位置</button><button class="mode-button {{movementMode === 'virtual' ? 'mode-active' : ''}}" data-mode="virtual" bindtap="selectMovementMode">点击地图行走</button><button class="mode-button {{movementMode === 'fuzzy' ? 'mode-active' : ''}}" data-mode="fuzzy" bindtap="selectMovementMode">模糊跟随</button></view>
    <view wx:if="{{movementMode === 'fuzzy'}}" class="fuzzy-note">仅在小程序前台每 30 秒检查一次位置；发送到地图的是约 500 米网格中心，不上传精确坐标。</view>
    <view class="speed-setting">
      <view class="speed-heading"><text>点击地图移动速度</text><text>{{movementSpeed}} 倍</text></view>
      <slider min="1" max="5" step="1" value="{{movementSpeed}}" activeColor="#202020" backgroundColor="#e7e7e2" block-size="24" bindchanging="speedChanging" bindchange="speedChanged" aria-label="点击地图移动速度" />
      <view class="speed-range"><text>慢 · 1 倍</text><text>快 · 5 倍</text></view>
      <view class="muted">松手自动保存，下次点击地图时生效。</view>
    </view>
    <block wx:if="{{movementMode !== 'fuzzy'}}">
      <view class="presence-modes"><button class="mode-button {{presenceMode === 'place' ? 'mode-active' : ''}}" data-mode="place" bindtap="selectPresenceMode">选定地点</button><button class="mode-button {{presenceMode === 'current' ? 'mode-active' : ''}}" data-mode="current" bindtap="selectPresenceMode">当前位置</button></view>
      <button wx:if="{{presenceMode === 'place'}}" class="secondary choose-place" bindtap="choosePresencePlace">{{presencePlace ? presencePlace.place : '选择公开地点'}}</button>
      <button wx:else class="secondary choose-place" bindtap="useCurrentLocation">{{presencePlace ? presencePlace.place : '获取一次当前位置'}}</button>
    </block>
    <view class="field presence-shout"><text class="label">附近喊话（选填）</text><input value="{{presenceShout}}" bindinput="presenceShoutInput" maxlength="80" placeholder="今天出的是哪个角色？想认识什么同好？" /></view>
    <view wx:if="{{presence && presence.expiresAt > 0}}" class="presence-status">地图出现中 · {{presence.movementMode === 'fuzzy' ? '约500米模糊跟随' : presence.movementMode === 'virtual' ? '虚拟漫游' : presence.place}}<text>，2 小时后自动结束</text></view>
    <button class="primary" bindtap="activatePresence" loading="{{presenceBusy}}" disabled="{{presenceBusy || (!cloudConfigured && !demoMode)}}">{{presence ? '更新并查看地图' : '开启并查看地图'}}</button>
    <button wx:if="{{presence}}" class="secondary" bindtap="stopPresence" disabled="{{presenceBusy || (!cloudConfigured && !demoMode)}}">从地图隐藏</button>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}<button class="retry" bindtap="load">重试</button></view>

</view>
<avatar-preview open="{{previewOpen}}" frames="{{previewFrames}}" bind:close="closePreview" />
