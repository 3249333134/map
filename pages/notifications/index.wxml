<view class="page"><view class="heading">消息 <text wx:if="{{unread}}" class="badge">{{unread}}</text></view><view class="muted">好友申请与内容互动都在这里，没有私聊。</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load">重试</button></view>
  <view wx:for="{{items}}" wx:key="_id" class="notice-row" data-id="{{item._id}}" bindtap="open" aria-role="button">
    <image wx:if="{{item.friendNotice && item.actor}}" class="notice-avatar" src="{{item.actor.avatarUrl || '/static/avatars/' + item.actor.avatarKey + '.png'}}" mode="aspectFill" />
    <view class="notice-main"><view class="row-title">{{item.read ? '' : '• '}}{{item.actorName ? item.actorName + ' ' : ''}}{{item.label}}</view><view class="muted">{{item.timeText}} · {{item.read ? '已读' : '未读'}}</view>
      <view wx:if="{{item.type === 'friend_request' && (item.friendStatus === 'pending' || !item.friendStatus) && !item.responseText}}" class="notice-actions"><button data-id="{{item._id}}" data-accept="true" catchtap="respondFriend" loading="{{item.friendBusy}}">同意</button><button class="notice-decline" data-id="{{item._id}}" data-accept="false" catchtap="respondFriend" disabled="{{item.friendBusy}}">忽略</button></view>
      <view wx:if="{{item.responseText}}" class="notice-response">{{item.responseText}}</view>
    </view>
  </view>
  <view wx:if="{{!items.length && !loading && !error}}" class="error">还没有通知，去附近地图认识同好吧。</view><view wx:if="{{loading}}" class="muted section">正在加载…</view><button wx:if="{{cursor && !loading}}" class="secondary" bindtap="loadMore">更多消息</button>
</view><bottom-nav selected="message" />
