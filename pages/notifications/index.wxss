@import '../../styles/pages.wxss';
.notice-row { display: flex; align-items: flex-start; gap: 12px; padding: 15px 0; border-bottom: 1px solid #ececea; }
.notice-avatar { flex: 0 0 42px; width: 42px; height: 42px; border-radius: 50%; background: #f3f3f1; }
.notice-main { flex: 1; min-width: 0; }
.notice-actions { display: flex; gap: 8px; margin-top: 12px; }
.notice-actions button { width: 72px; height: 34px; margin: 0; border-radius: 9px; background: #202020; color: #fff; font-size: 12px; line-height: 34px; }
.notice-actions .notice-decline { background: #f3f3f1; color: #555; }
.notice-response { margin-top: 10px; color: #737373; font-size: 12px; }
