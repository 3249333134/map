<view class="page">
  <view wx:if="{{!cloudConfigured && !demoMode}}" class="error">云环境尚未配置，暂时无法同步资料或在地图上出现。</view>
  <view class="profile-hero" bindtap="openSettings" aria-role="button" aria-label="我的资料与地图设置">
    <view class="profile-hero-avatar"><avatar-head src="{{avatarUrl ? avatarUrl : '/static/avatars/' + avatarKey + '.png'}}" full-body="{{avatarSource === 'ai'}}" /></view>
    <view class="profile-hero-info">
      <view class="profile-hero-name">{{nickname || '设置你的 Cos 形象'}}</view>
      <view class="profile-hero-tags">{{avatarSource === 'ai' ? '自定义形象已保存' : (tagsText || '添加角色与兴趣')}}</view>
    </view>
    <text class="profile-settings-link">资料与设置 ›</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view>
  <block wx:if="{{profile}}">
    <view class="section">
      <view class="section-heading">我的记录</view>
      <scroll-view class="tabs-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="tabs"><button wx:for="{{tabs}}" wx:key="id" class="{{section === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="tab">{{item.label}}</button></view></scroll-view>
      <block wx:if="{{section === 'friends'}}">
        <view wx:for="{{items}}" wx:key="id" class="friend-row card">
          <view class="friend-avatar"><avatar-head src="{{item.avatarUrl || '/static/avatars/' + item.avatarKey + '.png'}}" full-body="{{!!item.avatarFrameUrls.length}}" /></view>
          <view class="friend-copy"><view class="row-title">{{item.nickname}}</view><view class="muted">{{item.tags && item.tags.length ? item.tags.join(' · ') : '已成为好友'}}</view></view>
          <text class="friend-chip">好友</text>
        </view>
      </block>
      <block wx:else>
        <view wx:for="{{items}}" wx:key="id" class="record-card" bindtap="open" data-id="{{item.id}}" aria-role="button">
          <view class="record-top"><text class="record-kind">{{item.kind === 'activity' ? '活动' : '动态'}}</text><text class="record-status">{{item.statusText}}{{item.cancelled ? ' · 已取消' : ''}}</text></view>
          <view class="row-title">{{item.title}}</view>
          <view class="muted">{{item.place}}</view>
        </view>
      </block>
      <view wx:if="{{!items.length && !loading && !error}}" class="empty-card">
        <view class="empty-title">{{section === 'friends' ? '还没有好友' : '还没有相关记录'}}</view>
        <view class="empty-copy">{{section === 'friends' ? '去附近地图认识同好吧。' : '发布动态或报名活动后会显示在这里。'}}</view>
      </view>
      <button wx:if="{{cursor && !loading}}" class="secondary" bindtap="loadMore">更多记录</button>
    </view>
  </block>

  <button class="secondary section" bindtap="about">隐私说明与反馈</button>
  <button wx:if="{{profile.isAdmin}}" class="secondary" bindtap="admin">内容与举报管理</button>
  <view wx:if="{{loading}}" class="muted section">正在加载…</view>
</view>
