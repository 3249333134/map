@import '../../styles/pages.wxss';

.page { position: relative; z-index: 0; }

.profile-hero { display: flex; align-items: center; gap: 10px; padding: 14px; border-radius: 16px; background: #fff; }
.profile-hero-avatar { flex: 0 0 54px; width: 54px; height: 54px; overflow: hidden; border-radius: 50%; background: #f4f4f2; }
.friend-avatar { flex: 0 0 44px; width: 44px; height: 44px; overflow: hidden; border-radius: 50%; background: #f4f4f2; }
.profile-hero-info { flex: 1; min-width: 0; }
.profile-settings-link { flex-shrink: 0; color: #62625a; font-size: 12px; }
.profile-hero-name { overflow: hidden; color: #1c1c1a; font-size: 18px; font-weight: 700; line-height: 25px; white-space: nowrap; text-overflow: ellipsis; }
.profile-hero-tags { margin-top: 2px; overflow: hidden; color: #62625a; font-size: 12px; line-height: 18px; white-space: nowrap; text-overflow: ellipsis; }
.profile-map-button { flex: 0 0 auto; width: auto; min-height: 44px; margin: 0; padding: 0 10px; border-radius: 10px; background: #242420; color: #fff; font-size: 12px; line-height: 44px; font-weight: 600; }
.profile-map-button.online-pill { background: #eef2e5; color: #394b2b; }
.page .field input { box-sizing: border-box; padding: 0 12px; }

.card-title { margin-bottom: 6px; color: #1c1c1a; font-size: 17px; font-weight: 700; line-height: 24px; }
.section-heading { margin: 0 4px 4px; color: #1c1c1a; font-size: 17px; font-weight: 700; line-height: 26px; }

.page .saved-avatar { display: flex; width: 100%; align-items: center; gap: 12px; padding: 8px 12px; border-radius: 12px; background: #f4f4f2; text-align: left; }
.saved-avatar-image { flex: 0 0 48px; width: 48px; height: 48px; }
.saved-avatar-info { display: flex; flex-direction: column; gap: 3px; color: #1c1c1a; font-size: 14px; line-height: 19px; }
.saved-avatar-preview { color: #62625a; font-size: 12px; line-height: 16px; }
.avatar-actions { display: flex; gap: 10px; margin-top: 10px; }
.avatar-actions .secondary { flex: 1; width: auto; margin-top: 0; }

.presence-heading { color: #1c1c1a; font-size: 17px; font-weight: 700; line-height: 24px; }
.movement-modes { display: flex; gap: 6px; margin-top: 12px; }
.movement-modes .mode-button { padding: 0 4px; font-size: 11px; }
.fuzzy-note { margin-top: 10px; padding: 10px 12px; border-radius: 10px; background: #f2f0fa; color: #68617f; font-size: 11px; line-height: 17px; }
.presence-modes { display: flex; gap: 8px; margin-top: 14px; }
.mode-button { flex: 1; height: 40px; margin: 0; border-radius: 12px; background: #f4f4f2; color: #6a6a63; font-size: 12px; line-height: 40px; }
.mode-button.mode-active { background: #1c1c1a; color: #fff; font-weight: 600; }
.choose-place { margin-top: 10px; }
.presence-shout { margin-top: 8px; }
.presence-status { margin-top: 12px; padding: 10px 12px; border-radius: 12px; background: #eef2e5; color: #55663f; font-size: 12px; line-height: 18px; }
.presence-status text { color: #7c8a68; }

.tabs-scroll { width: 100%; white-space: nowrap; }
.tabs-scroll .tabs { display: inline-flex; flex-wrap: nowrap; margin: 6px 0 10px; }
.tabs button { border: 1px solid #ececea; background: #fff; }
.tabs button.active { border-color: #1c1c1a; }

.friend-row { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; padding: 14px 16px; }
.friend-row image { flex: 0 0 44px; width: 44px; height: 44px; border-radius: 50%; background: #f4f4f2; }
.friend-copy { flex: 1; min-width: 0; }
.friend-chip { flex: 0 0 auto; padding: 2px 8px; border-radius: 9px; background: #eef2e5; color: #55663f; font-size: 10px; line-height: 16px; }

.record-card { margin-bottom: 10px; padding: 16px; border-radius: 16px; background: #fff; box-shadow: 0 1px 2px rgba(24, 24, 20, .04); }
.record-card:active { background: #fafaf8; }
.record-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
.record-kind { padding: 2px 8px; border-radius: 8px; background: #f4f4f2; color: #6a6a63; font-size: 10px; line-height: 16px; }
.record-status { color: #8a8a82; font-size: 11px; line-height: 16px; }

.error { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.error .retry { flex: 0 0 auto; padding: 0 12px; border-radius: 9px; background: #fff; color: #8a4a3a; font-size: 12px; line-height: 30px; }
