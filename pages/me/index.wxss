@import '../../styles/pages.wxss';
.avatar-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
.avatar-option { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 64px; padding: 4px 0 6px; border-radius: 13px; color: #737373; font-size: 10px; }
.avatar-option image { width: 48px; height: 48px; border-radius: 50%; background: #f3f3f1; }
.avatar-option.avatar-selected { color: #202020; background: #f3f3f1; font-weight: 600; }
.chosen-photo { display: flex; align-items: center; gap: 10px; margin: 10px 0 0; color: #596746; font-size: 12px; }
.chosen-photo image { width: 44px; height: 44px; border-radius: 50%; background: #f3f3f1; }
.photo-button { margin-top: 4px; }
.map-presence { margin-top: 25px; padding: 18px 0; border-top: 1px solid #ececea; border-bottom: 1px solid #ececea; }
.presence-heading { margin-bottom: 6px; color: #202020; font-size: 17px; font-weight: 600; }
.presence-modes { display: flex; gap: 8px; margin-top: 15px; }
.mode-button { flex: 1; height: 38px; margin: 0; border-radius: 11px; background: #f3f3f1; color: #666; font-size: 12px; }
.mode-button.mode-active { background: #202020; color: #fff; }
.choose-place { margin-top: 10px; }
.presence-shout { margin-top: 10px; }
.presence-status { padding: 12px 0; color: #49643a; font-size: 12px; }
.presence-status text { color: #737373; }
.friend-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #ececea; }
.friend-row image { flex: 0 0 42px; width: 42px; height: 42px; border-radius: 50%; background: #f3f3f1; }
