@import '../../styles/pages.wxss';
.avatar-page { min-height: 100vh; padding: 12px 16px calc(100px + env(safe-area-inset-bottom)); background: #f5f4f2; }
.hero-card { overflow: hidden; border-radius: 24px; background: linear-gradient(145deg,#27283d 0%,#454362 52%,#6c5c7d 100%); color: #fff; box-shadow: 0 12px 28px rgba(43,37,63,.14); }
.hero-top { padding: 21px 20px 8px; }
.eyebrow { color: #d9c9fa; font-size: 9px; letter-spacing: 1.8px; font-weight: 700; }
.hero-title { margin-top: 8px; font-size: 21px; font-weight: 700; letter-spacing: .3px; }
.hero-copy { margin-top: 5px; color: rgba(255,255,255,.7); font-size: 11px; }
.preview-frame { position: relative; display: flex; align-items: center; justify-content: center; height: 300px; margin: 0 12px 12px; overflow: hidden; border-radius: 18px; background: radial-gradient(ellipse at 50% 43%,rgba(231,211,255,.22),rgba(27,29,47,.3) 72%); }
.preview-image { width: 100%; height: 100%; }
.pixelated { image-rendering: pixelated; }
.preview-empty { display: flex; flex-direction: column; align-items: center; gap: 12px; color: rgba(255,255,255,.68); font-size: 12px; }
.sparkle { color: #f8d896; font-size: 52px; line-height: 1; text-shadow: 0 0 30px rgba(248,216,150,.5); }
.preview-badge { position: absolute; right: 12px; bottom: 12px; padding: 5px 9px; border-radius: 20px; background: rgba(29,28,42,.7); color: #fff; font-size: 10px; }
.loader { width: 26px; height: 26px; border: 2px solid rgba(255,255,255,.25); border-top-color: #f8d896; border-radius: 50%; animation: rotate 800ms linear infinite; }
@keyframes rotate { to { transform: rotate(360deg); } }
.section { margin-top: 14px; padding: 16px; }
.section-title { color: #282735; font-size: 15px; font-weight: 700; }
.style-list { display: flex; flex-direction: column; gap: 8px; margin-top: 11px; }
.style-option { display: flex; align-items: center; gap: 11px; padding: 10px 11px; border: 1px solid #efeee9; border-radius: 14px; background: #fcfcfa; }
.style-selected { border-color: #9181c5; background: #f8f5ff; box-shadow: 0 0 0 1px rgba(145,129,197,.1); }
.style-dot { width: 30px; height: 30px; border-radius: 10px; box-shadow: inset 0 0 0 1px rgba(0,0,0,.05); }
.style-copy { display: flex; flex: 1; flex-direction: column; gap: 3px; }
.style-name { color: #292833; font-size: 12px; font-weight: 700; }
.style-hint { color: #99979d; font-size: 10px; }
.style-check { width: 18px; height: 18px; border: 1px solid #dedce5; border-radius: 50%; color: #7161ad; font-size: 12px; text-align: center; line-height: 18px; }
.style-selected .style-check { border-color: #9c8acb; background: #eee9ff; }
.prompt-field { margin-top: 14px; }
.label { display: block; color: #55535b; font-size: 11px; font-weight: 600; }
.optional { color: #aaa7ac; font-size: 10px; font-weight: 400; }
.prompt-field textarea { box-sizing: border-box; width: 100%; height: 72px; margin-top: 7px; padding: 9px 10px; border: 1px solid #ecebe7; border-radius: 12px; background: #fafaf8; color: #38363d; font-size: 11px; }
.prompt-field input { box-sizing: border-box; width: 100%; height: 38px; margin-top: 7px; padding: 0 10px; border: 1px solid #ecebe7; border-radius: 11px; background: #fafaf8; color: #38363d; font-size: 11px; }
.upload-row { margin-top: 14px; }
.upload-button { width: 100%; height: 38px; margin-top: 7px; border: 1px dashed #d7d4df; border-radius: 11px; background: #faf9fc; color: #766b98; font-size: 11px; }
.reference-preview { display: flex; align-items: center; gap: 9px; margin-top: 7px; color: #65616c; font-size: 10px; }
.reference-preview image { width: 42px; height: 42px; border-radius: 8px; background: #f0eef2; }
.remove-reference { margin-left: auto; color: #a25358; }
.generate-button { display: flex; align-items: center; justify-content: center; gap: 7px; height: 44px; margin-top: 13px; border: 0; border-radius: 13px; background: #292735; color: #fff; font-size: 13px; font-weight: 600; }
.generate-button text { color: #f5d48e; }
.cost-note { display: block; margin-top: 8px; color: #aaa7ac; font-size: 9px; text-align: center; }
.error-card { margin-top: 12px; padding: 11px 13px; border-radius: 12px; background: #fff0ee; color: #ae554c; font-size: 11px; line-height: 17px; }
.footer { position: fixed; right: 0; bottom: 0; left: 0; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: rgba(245,244,242,.96); box-shadow: 0 -1px 0 rgba(24,24,20,.05); }
.save-button { width: 100%; height: 46px; margin: 0; border-radius: 14px; background: #7769a9; color: #fff; font-size: 14px; font-weight: 600; }
.save-button[disabled] { background: #d0cdd7; color: #fff; }
